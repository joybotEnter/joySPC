@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="corp-page">
    <div class="corp-emp-header">
        <h1>PRIVACY POLICY</h1>
        <div class="divider"></div>
        <p>How State Properties Corporation handles your information.</p>
    </div>

    <div class="corp-section" style="border-bottom:none;">
        <h2>Information We Collect</h2>
        <div class="divider-small"></div>
        <p>
            This system may collect and store employee information — such as name, email address,
            position, salary, date hired, and photograph — for the purpose of internal record-keeping
            and administration.
        </p>
    </div>

    <div class="corp-section">
        <h2>How We Use Information</h2>
        <div class="divider-small"></div>
        <p>
            Information stored in this system is used solely for internal purposes, including employee
            management and organizational records. It is not shared with third parties outside the
            organization except where required by law.
        </p>
    </div>

    <div class="corp-section">
        <h2>Data Security</h2>
        <div class="divider-small"></div>
        <p>
            We take reasonable measures to protect stored information from unauthorized access, alteration,
            or disclosure. Access to this system is limited to authorized personnel only.
        </p>
    </div>

    <div class="corp-section">
        <h2>Cookies</h2>
        <div class="divider-small"></div>
        <p>
            This website uses a single functional cookie-equivalent stored in your browser's local storage
            to remember whether you've acknowledged this notice, so it isn't shown to you again. We do not
            currently use analytics, advertising, or third-party tracking cookies.
        </p>
        <p>
            The chat assistant available on this site runs entirely in your browser. It does not send your
            questions to a server or store your conversation anywhere — it is cleared automatically when you
            close or refresh the page.
        </p>
        <p>
            If we introduce features that require additional cookies in the future (such as visitor
            analytics or an account login), this policy will be updated accordingly.
        </p>
    </div>

    <div class="corp-section" style="border-bottom:none;">
        <h2>Contact</h2>
        <div class="divider-small"></div>
        <p>
            For questions regarding this policy or the information stored in this system, please contact
            your system administrator.
        </p>
        <p style="color:#999; font-size:0.85rem; margin-top:20px;">
            <em>This is placeholder text for demonstration purposes and does not constitute a legally binding policy.</em>
        </p>
    </div>
</div>