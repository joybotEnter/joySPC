@page
@model _1JOY_try.Pages_Employees.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<div class="corp-page">
    <div class="corp-emp-header">
        <h1>EMPLOYEE PROFILE</h1>
        <div class="divider"></div>
        <p>@Model.Employee.FullName</p>
    </div>

    <div class="corp-emp-body" style="max-width: 600px;">
        <div style="background:white; border:1px solid #e5decb; border-top:3px solid #c9a24b; box-shadow: 0 2px 10px rgba(11,31,58,0.08); overflow:hidden;">
            <div class="corp-emp-photo" style="height:220px;">
                @if (!string.IsNullOrEmpty(Model.Employee.PhotoPath))
                {
                    <img src="@Model.Employee.PhotoPath" alt="@Model.Employee.FullName" />
                }
                else
                {
                    <div class="corp-emp-photo-placeholder">👤</div>
                }
            </div>
            <div class="corp-emp-body-inner">
                <div class="corp-emp-badge-row">
                    <div class="corp-emp-id">ID #@Model.Employee.Id</div>
                    <span class="corp-status-badge corp-status-@Model.Employee.Status.ToString().ToLower()">@Model.Employee.Status</span>
                </div>
                <h3>@Model.Employee.FullName</h3>
                <p class="corp-emp-position">@Model.Employee.Position</p>
                <p class="corp-emp-detail"><strong>Email:</strong> @Model.Employee.Email</p>
                <p class="corp-emp-detail"><strong>Salary:</strong> @Model.Employee.Salary.ToString("C")</p>
                <p class="corp-emp-detail"><strong>Date Hired:</strong> @Model.Employee.DateHired.ToShortDateString()</p>
                <p class="corp-emp-detail"><strong>Department:</strong> @(Model.Employee.Department?.Name ?? "Unassigned")</p>
            </div>
        </div>

        <div style="margin-top: 20px; display:flex; gap:10px;">
            <a asp-page="Edit" asp-route-id="@Model.Employee.Id" class="btn-corp">EDIT</a>
            <a asp-page="Index" style="color:#0b1f3a; align-self:center;">← Back to Team</a>
        </div>
    </div>
</div>